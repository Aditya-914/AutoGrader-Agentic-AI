{
  "problem": "divide_two_integers",
  "problem_description": "Read two integers a and b on a single line separated by whitespace and print their division a/b upto 2 decimal places. The program must handle zero denominator and print \"Divide by 0 is invalid\".",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "sample_input": "10 5",
  "llm_config": {
    "model": "llama3.1",
    "temperature": 0,
    "seed": 42
  },
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.2,
      "params": {
        "testset_dir": "tests/divide_two_integers/",
        "auto_generate": true,
        "num_tests": 10
      }
    },
    {
      "name": "syntax",
      "analyzer": "compiler_warnings",
      "weight": 0.1,
      "params": {
        "flags": "-Wall -Wextra -Werror -std=c11"
      }
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.1,
      "params": {
        "max_cyclomatic": 8,
        "max_function_length": 40
      }
    },
    {
      "name": "modularity",
      "analyzer": "function_split",
      "weight": 0.1,
      "params": {
        "expect_helpers": true,
        "min_functions": 2
      }
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.1,
      "params": {
        "auto_generate": true,
        "cases": [
          "negatives",
          "zero",
          "int_overflow",
          "whitespace_formatting"
        ]
      }
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.1,
      "params": {
        "required": "O(1)",
        "sizes": [
          1,
          10,
          100
        ],
        "required_space": "O(1)"
      }
    },
    {
      "name": "memory_safety",
      "analyzer": "sanitizer_run",
      "weight": 0.1,
      "params": {
        "flags": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "readability",
      "analyzer": "llm_review",
      "weight": 0.1,
      "params": {
        "model": "llama3.1",
        "temperature": 0,
        "seed": 42
      }
    },
    {
      "name": "originality",
      "analyzer": "similarity_flag",
      "weight": 0.1,
      "params": {
        "corpus_dir": "corpus/",
        "flag_threshold": 0.85
      }
    }
  ],
  "sample_output": "2.00"
}